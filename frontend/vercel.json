{
  "buildCommand": "npx expo export --platform web",
  "outputDirectory": "dist",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://junction-travel.up.railway.app/api/:path*"
    },
    {
      "source": "/((?!api/|_expo/|assets/|favicon\\.).*)",
      "destination": "/index.html"
    }
  ]
}
